// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PreferredFoot {
  LEFT
  RIGHT
}

enum PositionCode {
  GOL
  ZAG
  LD
  LE
  VOL
  MC
  MD
  ME
  MEI
  PD
  PE
  ATA
}

model Nationality {
  id      String @id @default(uuid()) @db.Uuid
  name    String @unique
  flagUrl String

  players Player[]
}

model League {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  teams Team[]
}

model Team {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  // Chave natural real do time: dois times diferentes podem ter o mesmo
  // nome (ex.: "Nacional" do Uruguai e de Portugal), mas o crestUrl da EA
  // nunca colide entre times distintos.
  crestUrl String @unique

  leagueId String @db.Uuid
  league   League @relation(fields: [leagueId], references: [id])

  players Player[]
  squads  Squad[]
  seasonAssignments PlayerTeamAssignment[]

  @@index([name])
}

model Player {
  id            String        @id @default(uuid()) @db.Uuid
  // id do jogador no scraper (SoFIFA/EA), usado como chave de upsert na importação.
  eaId          Int           @unique
  name          String
  photoUrl      String
  birthdate     DateTime
  preferredFoot PreferredFoot

  nationalityId String      @db.Uuid
  nationality   Nationality @relation(fields: [nationalityId], references: [id])

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])

  positions PlayerPosition[]
  ratings   PlayerRating[]
  seasonAssignments PlayerTeamAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerPosition {
  id        String       @id @default(uuid()) @db.Uuid
  playerId  String       @db.Uuid
  player    Player       @relation(fields: [playerId], references: [id])
  position  PositionCode
  isPrimary Boolean      @default(false)

  @@unique([playerId, position])
}

// Série histórica dos atributos do jogador: só ganha uma linha nova quando
// o scraper traz algum valor diferente da última captura (ver import).
model PlayerRating {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  // Momento em que o scraper coletou esta versão dos dados (não a data do import).
  capturedAt      DateTime
  overallRating   Int
  skillMoves      Int
  weakFootAbility Int

  // Categorias agregadas (PAC/SHO/PAS/DRI/DEF/PHY)
  pac Int
  sho Int
  pas Int
  dri Int
  def Int
  phy Int

  // Atributos detalhados
  acceleration       Int
  agility            Int
  jumping            Int
  stamina            Int
  strength           Int
  aggression         Int
  balance            Int
  ballControl        Int
  composure          Int
  crossing           Int
  curve              Int
  defensiveAwareness Int
  dribbling          Int
  finishing          Int
  freeKickAccuracy   Int
  headingAccuracy    Int
  interceptions      Int
  longPassing        Int
  longShots          Int
  penalties          Int
  positioning        Int
  reactions          Int
  shortPassing       Int
  shotPower          Int
  slidingTackle      Int
  sprintSpeed        Int
  standingTackle     Int
  vision             Int
  volleys            Int

  // Atributos de goleiro (presentes em todo jogador, baixos para linha de campo)
  gkDiving      Int
  gkHandling    Int
  gkKicking     Int
  gkPositioning Int
  gkReflexes    Int

  @@index([playerId, capturedAt])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  pinHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  squads   Squad[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Uma temporada funciona como o "tenant" da liga: todo estado de elenco e
// transferência pertence a uma temporada. Uma nova temporada começa com os
// jogadores nos times reais (vindos do scraper) — ver PlayerTeamAssignment.
model Season {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startedAt DateTime @default(now())

  squads      Squad[]
  assignments PlayerTeamAssignment[]
}

// O elenco de um participante numa temporada: o time real que ele escolheu
// representar. Os jogadores do elenco são derivados via PlayerTeamAssignment
// (quem está "no time X" dentro dessa temporada), não guardados aqui.
model Squad {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  teamId   String @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())

  @@unique([seasonId, userId])
  @@unique([seasonId, teamId])
}

// "Foto", dentro de uma temporada, de qual time cada jogador defende na liga.
// Criada a partir do Player.teamId real quando a temporada começa; trocas
// (Transferência, etapa futura) alteram só essa foto, nunca o Player.teamId.
model PlayerTeamAssignment {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])
  teamId   String @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])

  @@unique([seasonId, playerId])
  @@index([seasonId, teamId])
}