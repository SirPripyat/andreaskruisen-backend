// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PreferredFoot {
  LEFT
  RIGHT
}

enum PositionCode {
  GOL
  ZAG
  LD
  LE
  VOL
  MC
  MD
  ME
  MEI
  PD
  PE
  ATA
}

// Grid de posições do SoFIFA usado só em PlayerPositionRating (overall do
// jogador em cada posição do campo, pra medir versatilidade). Mais granular
// que PositionCode (ex.: separa perna esquerda/direita de ala, meia e
// ataque) e não deve ser confundido com ele: PositionCode continua sendo a
// fonte de verdade pras regras de elenco/escalação.
enum SofifaPositionCode {
  ATE
  ATA
  ATD
  PE
  MAE
  SA
  MAD
  PD
  MEE
  MEI
  MED
  ME
  MCE
  MC
  MCD
  MD
  ADE
  VE
  VOL
  VD
  ADD
  LE
  ZGE
  ZAG
  ZGD
  LD
  GOL
}

// Catálogo fechado das formações que aparecem no JSON de formações do
// scraper (ver src/import/formation-mapper.ts para o mapeamento entre o
// texto em português do scraper e estes valores).
enum Formation {
  THREE_ONE_FOUR_TWO           @map("3-1-4-2")
  THREE_FOUR_ONE_TWO           @map("3-4-1-2")
  THREE_FOUR_TWO_ONE           @map("3-4-2-1")
  THREE_FOUR_THREE             @map("3-4-3")
  THREE_FOUR_THREE_EM_LINHA    @map("3-4-3 Em linha")
  THREE_FIVE_TWO               @map("3-5-2")
  FOUR_ONE_TWO_ONE_TWO_ABERTO  @map("4-1-2-1-2 Aberto")
  FOUR_ONE_TWO_ONE_TWO_FECHADO @map("4-1-2-1-2 Fechado")
  FOUR_ONE_THREE_TWO           @map("4-1-3-2")
  FOUR_ONE_FOUR_ONE            @map("4-1-4-1")
  FOUR_TWO_ONE_THREE           @map("4-2-1-3")
  FOUR_TWO_TWO_TWO             @map("4-2-2-2")
  FOUR_TWO_THREE_ONE_ABERTO    @map("4-2-3-1 Aberto")
  FOUR_TWO_THREE_ONE_FECHADO   @map("4-2-3-1 Fechado")
  FOUR_THREE_ONE_TWO           @map("4-3-1-2")
  FOUR_THREE_TWO_ONE           @map("4-3-2-1")
  FOUR_THREE_THREE_CONSERVADOR @map("4-3-3 Conservador")
  FOUR_THREE_THREE_DEFENSIVO   @map("4-3-3 Defensivo")
  FOUR_THREE_THREE_EM_LINHA    @map("4-3-3 Em linha")
  FOUR_THREE_THREE_OFENSIVO    @map("4-3-3 Ofensivo")
  FOUR_FOUR_ONE_ONE_MEIO_CAMPO @map("4-4-1-1 Meio-campo")
  FOUR_FOUR_ONE_ONE_OFENSIVO   @map("4-4-1-1 Ofensivo")
  FOUR_FOUR_TWO_CONSERVADOR    @map("4-4-2 Conservador")
  FOUR_FOUR_TWO_EM_LINHA       @map("4-4-2 Em linha")
  FOUR_FIVE_ONE_EM_LINHA       @map("4-5-1 Em linha")
  FIVE_TWO_ONE_TWO             @map("5-2-1-2")
  FIVE_TWO_TWO_ONE             @map("5-2-2-1")
  FIVE_TWO_THREE               @map("5-2-3")
  FIVE_THREE_TWO_CONSERVADOR   @map("5-3-2 Conservador")
  FIVE_FOUR_ONE_EM_LINHA       @map("5-4-1 Em linha")
  FIVE_FOUR_ONE_LOSANGO        @map("5-4-1 Losango")
}

model Nationality {
  id      String @id @default(uuid()) @db.Uuid
  name    String @unique
  flagUrl String

  // Coluna gerada pelo Postgres (lower(unaccent(name))), mantida só pra
  // busca por nome ignorar acento (ver migration add_name_search_unaccent).
  // Nunca é setada pela aplicação — o banco recalcula sozinho a cada
  // escrita em `name`.
  nameSearch String? @default(dbgenerated("lower(immutable_unaccent(name))"))

  players Player[]
  leagues League[]
}

model League {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  logoUrl   String?
  countryId String?      @db.Uuid
  country   Nationality? @relation(fields: [countryId], references: [id])

  nameSearch String? @default(dbgenerated("lower(immutable_unaccent(name))"))

  teams Team[]
}

model Team {
  id   String @id @default(uuid()) @db.Uuid
  name String

  nameSearch String? @default(dbgenerated("lower(immutable_unaccent(name))"))
  // Só exibição: o SoFIFA varia a resolução da imagem do escudo entre
  // execuções do scraper (ex.: .../90.png numa leva, .../60.png na
  // seguinte), então não é estável o suficiente pra ser chave de upsert
  // (já causou Team duplicado - ver @@unique([name, leagueId]) abaixo).
  crestUrl   String

  // Formação padrão do time real, vinda do JSON de formações do scraper
  // (arquivo separado do de jogadores). Nula até a primeira importação.
  formation Formation?

  leagueId String @db.Uuid
  league   League @relation(fields: [leagueId], references: [id])

  players                 Player[]
  squads                  Squad[]
  seasonAssignments       PlayerTeamAssignment[]
  tournamentEntries       TournamentTeam[]
  matchesHome             Match[]                @relation("MatchHomeTeam")
  matchesAway             Match[]                @relation("MatchAwayTeam")
  matchesPenaltyWon       Match[]                @relation("MatchPenaltyWinner")
  goalsScored             Goal[]                 @relation("GoalScoringTeam")
  transfersAsOutgoingTeam Transfer[]             @relation("TransferOutgoingTeam")
  transfersAsIncomingTeam Transfer[]             @relation("TransferIncomingTeam")
  lineupSlots             TeamLineupSlot[]
  aliases                 TeamAlias[]

  // Chave natural real do time: o nome por si só pode colidir (ex.:
  // "Nacional" do Uruguai e de Portugal), mas nome dentro da mesma liga não
  // (dois times da mesma liga não têm o mesmo nome).
  @@unique([name, leagueId])
}

// Nome alternativo pelo qual um time é conhecido num catálogo externo além
// do seu Team.name canônico (ex.: "PSG" pro Paris Saint-Germain) — usado só
// pra resolver o import de escudos (ver team-crest-import.ts) quando o
// catálogo de times da EA usa uma abreviação que o de jogadores (fonte do
// Team.name) não usa. Curado manualmente; não afeta o que é exibido no app.
model TeamAlias {
  id    String @id @default(uuid()) @db.Uuid
  alias String @unique

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])
}

model Player {
  id            String        @id @default(uuid()) @db.Uuid
  // id do jogador no scraper (SoFIFA/EA), usado como chave de upsert na importação.
  eaId          Int           @unique
  name          String
  // Gerada pelo Postgres (lower(unaccent(name))); ver nota em Nationality.nameSearch.
  nameSearch    String?       @default(dbgenerated("lower(immutable_unaccent(name))"))
  photoUrl      String
  birthdate     DateTime
  preferredFoot PreferredFoot

  nationalityId String      @db.Uuid
  nationality   Nationality @relation(fields: [nationalityId], references: [id])

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])

  // Cópia do overall mais recente (igual ao último PlayerRating), mantida
  // pela importação só pra permitir ordenar a listagem por overall sem
  // precisar de uma query correlacionada em PlayerRating (histórico 1:N).
  latestOverallRating Int

  positions          PlayerPosition[]
  ratings            PlayerRating[]
  seasonAssignments  PlayerTeamAssignment[]
  goalsScored        Goal[]                    @relation("GoalScorer")
  goalsAssisted      Goal[]                    @relation("GoalAssist")
  transfersOut       Transfer[]                @relation("TransferOutgoingPlayer")
  transfersIn        Transfer[]                @relation("TransferIncomingPlayer")
  negotiationsOut    DirectNegotiation[]       @relation("DirectNegotiationOutgoingPlayer")
  negotiationsIn     DirectNegotiation[]       @relation("DirectNegotiationIncomingPlayer")
  negotiationClauses DirectNegotiationClause[]
  lineupSlots        TeamLineupSlot[]
  favoritedBy        FavoritePlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([latestOverallRating])
}

model PlayerPosition {
  id        String       @id @default(uuid()) @db.Uuid
  playerId  String       @db.Uuid
  player    Player       @relation(fields: [playerId], references: [id])
  position  PositionCode
  isPrimary Boolean      @default(false)

  @@unique([playerId, position])
}

// Escalação titular calculada do time (ver selectStartingLineup): quais 11
// jogadores do elenco real (Player.teamId) entram na média de overall do
// time, e em qual posição da formação cada um entraria. Recalculada inteira
// (delete + insert) a cada mudança de elenco ou via endpoint manual — nunca
// editada linha a linha. Time sem nenhuma linha aqui = escalação nunca
// calculada, e a média do time cai pro elenco inteiro (ver teams.repository).
model TeamLineupSlot {
  id       String       @id @default(uuid()) @db.Uuid
  teamId   String       @db.Uuid
  team     Team         @relation(fields: [teamId], references: [id])
  // Posição exigida pelo slot da formação, não necessariamente a posição
  // principal do jogador: quando o elenco não tem jogador suficiente numa
  // posição, o slot é preenchido pelo melhor jogador que sobrar de outra
  // posição (ver selectStartingLineup).
  position PositionCode
  playerId String       @db.Uuid
  player   Player       @relation(fields: [playerId], references: [id])

  @@unique([teamId, playerId])
}

// Série histórica dos atributos do jogador: só ganha uma linha nova quando
// o scraper traz algum valor diferente da última captura (ver import).
model PlayerRating {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  // Momento em que o scraper coletou esta versão dos dados (não a data do import).
  capturedAt      DateTime
  overallRating   Int
  skillMoves      Int
  weakFootAbility Int

  // Categorias agregadas (PAC/SHO/PAS/DRI/DEF/PHY). Opcionais: o scraper
  // deixou de enviá-las numa leva recente de dados.
  pac Int?
  sho Int?
  pas Int?
  dri Int?
  def Int?
  phy Int?

  // Atributos detalhados
  acceleration       Int
  agility            Int
  jumping            Int
  stamina            Int
  strength           Int
  aggression         Int
  balance            Int
  ballControl        Int
  composure          Int
  crossing           Int
  curve              Int
  defensiveAwareness Int
  dribbling          Int
  finishing          Int
  freeKickAccuracy   Int
  headingAccuracy    Int
  interceptions      Int
  longPassing        Int
  longShots          Int
  penalties          Int
  positioning        Int
  reactions          Int
  shortPassing       Int
  shotPower          Int
  slidingTackle      Int
  sprintSpeed        Int
  standingTackle     Int
  vision             Int
  volleys            Int

  // Atributos de goleiro (presentes em todo jogador, baixos para linha de campo)
  gkDiving      Int
  gkHandling    Int
  gkKicking     Int
  gkPositioning Int
  gkReflexes    Int

  specialities    PlayerRatingSpeciality[]
  roles           PlayerRatingRole[]
  positionRatings PlayerPositionRating[]

  @@index([playerId, capturedAt])
}

// Catálogo fechado dos traços de jogador do SoFIFA (ex.: "Matador", "Chuta
// de Longe"). Normalizado como Nationality/League/Team porque é resolvido
// do mesmo jeito na importação (upsert por nome).
model Speciality {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  ratings PlayerRatingSpeciality[]
}

// Traços do jogador numa captura específica do scraper — versionado junto
// com PlayerRating (não com Player) porque os traços dependem dos atributos
// daquele build, assim como o overall.
model PlayerRatingSpeciality {
  id             String       @id @default(uuid()) @db.Uuid
  playerRatingId String       @db.Uuid
  playerRating   PlayerRating @relation(fields: [playerRatingId], references: [id])
  specialityId   String       @db.Uuid
  speciality     Speciality   @relation(fields: [specialityId], references: [id])

  @@unique([playerRatingId, specialityId])
}

// Papéis táticos que o jogador desempenha numa posição (ex.: ATA/Centroavante
// nível 2), na captura do scraper que gerou este PlayerRating. position usa
// o PositionCode canônico (os valores observados no JSON cabem nele).
model PlayerRatingRole {
  id             String       @id @default(uuid()) @db.Uuid
  playerRatingId String       @db.Uuid
  playerRating   PlayerRating @relation(fields: [playerRatingId], references: [id])
  position       PositionCode
  name           String
  level          Int

  @@unique([playerRatingId, position, name])
}

// Overall do jogador em cada posição do grid do SoFIFA (ver SofifaPositionCode),
// na captura do scraper que gerou este PlayerRating. Dado de versatilidade/
// exibição, não usado nas regras de elenco (essas seguem em PlayerPosition).
model PlayerPositionRating {
  id             String             @id @default(uuid()) @db.Uuid
  playerRatingId String             @db.Uuid
  playerRating   PlayerRating       @relation(fields: [playerRatingId], references: [id])
  position       SofifaPositionCode
  overall        Int
  base           Int
  bonus          Int
  natural        Boolean

  @@unique([playerRatingId, position])
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  pinHash   String
  role      UserRole @default(PARTICIPANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Temporada que esse usuário escolheu ver. Null = ainda não escolheu, cai
  // no fallback global (Season.isActive) até escolher uma vez. onDelete:
  // SetNull porque apagar a season só deve resetar a escolha do usuário pro
  // default global, nunca bloquear a exclusão da season.
  selectedSeasonId String? @db.Uuid
  selectedSeason   Season? @relation(fields: [selectedSeasonId], references: [id], onDelete: SetNull)

  sessions           Session[]
  squads             Squad[]
  transfersRequested Transfer[]
  favoritePlayers    FavoritePlayer[]
  notifications      Notification[]

  openedNegotiationWindows NegotiationWindow[] @relation("NegotiationWindowOpenedBy")
  closedNegotiationWindows NegotiationWindow[] @relation("NegotiationWindowClosedBy")

  avatarPath String?
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Uma temporada funciona como o "tenant" da liga: todo estado de elenco e
// transferência pertence a uma temporada. Uma nova temporada começa com os
// jogadores nos times reais (vindos do scraper) — ver PlayerTeamAssignment.
model Season {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startedAt DateTime @default(now())
  // Temporada em que o app está operando agora. No máximo uma por vez — o
  // service sempre desmarca as outras antes de marcar uma nova (ver
  // SeasonsService.selectActive), dentro de uma transação.
  isActive  Boolean  @default(false)

  // Nula até o saldo inicial de cada squad ser calculado (ver
  // docs/regras-temporada/saldo-inicial.md) — ação separada da criação da
  // temporada, porque squads podem ser escolhidos depois (SquadsFacade.choose).
  // Marcada nesse momento pra essa ação não poder rodar duas vezes.
  economyStartedAt DateTime?

  squads             Squad[]
  assignments        PlayerTeamAssignment[]
  tournaments        Tournament[]
  transfers          Transfer[]
  directNegotiations DirectNegotiation[]
  selectedByUsers    User[]
  favoritePlayers    FavoritePlayer[]
  rulesets           Ruleset[]
  negotiationWindows NegotiationWindow[]
  notifications      Notification[]
}

// Regras de economia da temporada (ver CLAUDE.md, "princípio mais
// importante: a economia é configurável") — nada de valor de prêmio/custo
// fica fixo no código, fica aqui. Uma season pode ter mais de uma versão
// ao longo do tempo (ex.: o grupo decide mudar um valor no meio da
// temporada); a auditoria sempre deve usar a versão vigente na época de
// cada operação (validFrom mais recente que não seja depois da operação),
// nunca a versão atual — ver GetActiveRulesetUseCase.
model Ruleset {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  version  Int

  // Validado por RulesetPayloadSchema (zod) antes de gravar — nunca lido
  // sem revalidar (o schema pode evoluir; não dá pra confiar que o que
  // está salvo bate com o shape atual sem reparsear).
  payload Json

  validFrom DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([seasonId, version])
  @@index([seasonId, validFrom])
}

// O elenco de um participante numa temporada: o time real que ele escolheu
// representar. Os jogadores do elenco são derivados via PlayerTeamAssignment
// (quem está "no time X" dentro dessa temporada), não guardados aqui.
model Squad {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  teamId   String @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())

  // Marcada quando o técnico edita a escalação/banco manualmente (ver
  // SwapLineupStarterUseCase). A partir daí, TransfersRepository.swap para
  // de recalcular titular/banco por overall pra esse time: quem entra numa
  // troca sempre nasce no banco, e o técnico decide quem promove.
  hasManualLineup Boolean @default(false)

  // Formação usada pelo técnico nessa temporada, editável (ver
  // ChangeSquadFormationUseCase). Nula até a primeira troca manual: até lá,
  // a exibição cai pro Team.formation (formação real do time, vinda do
  // scraper) — ver SquadsRepository.findLineupOverview.
  formation Formation?

  coinTransactions   CoinTransaction[]
  couponTransactions CouponTransaction[]

  proposedNegotiations DirectNegotiation[] @relation("DirectNegotiationProposingSquad")
  receivedNegotiations DirectNegotiation[] @relation("DirectNegotiationTargetSquad")

  @@unique([seasonId, userId])
  @@unique([seasonId, teamId])
}

// Origem de um lançamento no ledger de moedas de um squad.
enum CoinTransactionType {
  INITIAL
  // Custo de qualquer movimentação (ver Transfer.originType): o custo fixo
  // do mercado tradicional, ou o coinAmount livremente acordado numa
  // negociação direta.
  TRANSFER
  // Taxa de negociação (ver NegotiationWindow) numa troca entre
  // participantes — só existe quando Transfer.originType = NEGOTIATION e a
  // janela aberta tinha feeEnabled = true. No mercado tradicional a taxa já
  // vem embutida num único lançamento TRANSFER, nunca separada.
  TRANSFER_FEE
  // Avanço de fase (mata-mata) ou posição na fase de grupos/liga — ver
  // tournament-prizes.utils.ts.
  PRIZE_PHASE
  RANKING
  WIN
  DRAW
  LOSS
  CHAMPION
  RUNNER_UP
  ADJUSTMENT
}

// Ledger append-only de moedas: o saldo de um squad é sempre a soma de
// CoinTransaction.amount, nunca um campo editável (ver
// docs/regras-temporada/saldo-inicial.md e v1-transferencias.md). Nenhuma
// transação é editada ou apagada — correções entram como uma nova
// transação (do mesmo tipo quando é prêmio reconciliável — ver
// tournament-prizes.utils.ts — ou ADJUSTMENT pra correções manuais).
model CoinTransaction {
  id      String              @id @default(uuid()) @db.Uuid
  squadId String              @db.Uuid
  squad   Squad               @relation(fields: [squadId], references: [id])
  type    CoinTransactionType
  amount  Int

  // Liga o lançamento à movimentação (mercado ou negociação aceita, ver
  // Transfer.originType) que o gerou — não é mais @unique: uma negociação
  // pode gerar até 3 lançamentos (coinAmount dos dois lados + taxa), o
  // mercado tradicional continua gerando sempre exatamente 1.
  transferId String?   @db.Uuid
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  // Só setado quando type = WIN/DRAW/LOSS, ou CHAMPION/RUNNER_UP decidido
  // numa final de mata-mata: liga o lançamento à partida que o gerou. Não é
  // @unique — até 2 squads por partida, mais o lançamento de correção se o
  // placar for reaberto depois (mesmo type, com a diferença).
  matchId String? @db.Uuid
  match   Match?  @relation(fields: [matchId], references: [id])

  // Só setado quando type = PRIZE_PHASE/RANKING, ou CHAMPION/RUNNER_UP
  // decidido pela tabela de uma LEAGUE (sem final pra apontar): liga o
  // lançamento à fase que o gerou. Não é @unique — todos os squads daquela
  // fase recebem um lançamento, mais eventual correção.
  phaseId String? @db.Uuid
  phase   Phase?  @relation(fields: [phaseId], references: [id])

  createdAt DateTime @default(now())

  @@index([squadId])
  @@index([transferId])
  @@index([matchId])
  @@index([phaseId])
}

// Origem de um lançamento no ledger de cupons de isenção de taxa (ver
// docs/regras-temporada/v1-transferencias.md, seção 3). GRANTED = concessão
// (venda ou negociação direta), USED = consumo numa contratação do mercado
// tradicional, ADJUSTMENT = correção manual.
enum CouponTransactionType {
  GRANTED
  USED
  ADJUSTMENT
}

// Ledger append-only de cupons de isenção de taxa: o saldo de cupons de um
// squad é sempre a soma de CouponTransaction.amount, nunca um campo editável
// — mesmo princípio do ledger de moedas (CoinTransaction) acima. Nenhuma
// transação é editada ou apagada — correções entram como ADJUSTMENT.
model CouponTransaction {
  id      String                @id @default(uuid()) @db.Uuid
  squadId String                @db.Uuid
  squad   Squad                 @relation(fields: [squadId], references: [id])
  type    CouponTransactionType
  amount  Int

  // Liga o lançamento à movimentação que o gerou (ver Transfer.originType):
  // USED sempre aponta pra um Transfer de mercado; GRANTED pode apontar pra
  // um Transfer nascido de negociação direta. Não é mais @unique — uma
  // troca entre participantes concede cupom aos dois squads (2 lançamentos
  // pro mesmo Transfer).
  transferId String?   @db.Uuid
  transfer   Transfer? @relation(fields: [transferId], references: [id])

  createdAt DateTime @default(now())

  @@index([squadId])
  @@index([transferId])
}

// Lista pessoal de jogadores "favoritados" por um participante, dentro de
// uma temporada (ex.: alvos de troca que ele quer acompanhar). Uma linha
// por combinação user+season+player; nada a mais que isso — exclusão é
// definitiva (sem soft delete), já que é só uma lista de atalho, não um
// registro contábil como o ledger de moedas.
model FavoritePlayer {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])

  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, seasonId, playerId])
}

enum TournamentFormat {
  // Liga: todos os times num turno único só (tabela), sem mata-mata — o
  // campeão é sempre o líder da tabela, por isso não faz sentido dividir em
  // mais de um grupo (não haveria confronto entre os líderes pra decidir).
  LEAGUE
  KNOCKOUT
  GROUP_STAGE_KNOCKOUT
}

// Um torneio dentro de uma temporada, com um conjunto fixo de times (ver
// TournamentTeam). Nem todo time do torneio tem dono: times sem Squad
// correspondente na mesma temporada são "máquinas" (CPU).
model Tournament {
  id        String           @id @default(uuid()) @db.Uuid
  seasonId  String           @db.Uuid
  season    Season           @relation(fields: [seasonId], references: [id])
  name      String
  format    TournamentFormat
  // Limite de times no torneio, validado contra as faixas do formato
  // (ver TEAM_COUNT_RULES em tournament-format-rules.ts).
  maxTeams  Int
  createdAt DateTime         @default(now())

  teams  TournamentTeam[]
  phases Phase[]

  @@index([seasonId])
}

// Os times que participam de um torneio. Quem controla cada time (ou se é
// CPU) não fica aqui: é derivado olhando o Squad dessa temporada pro mesmo
// teamId (existe Squad = tem dono; não existe = time de máquina).
model TournamentTeam {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamId       String     @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, teamId])
}

enum PhaseType {
  GROUP
  KNOCKOUT
}

// Uma etapa do torneio (ex.: fase de grupos, semifinal). As partidas de uma
// fase são todas geradas de uma vez, quando a fase começa; a fase seguinte só
// é gerada depois que esta termina (os confrontos dependem de quem avançou),
// então por ora só existe a Phase 1 — gerada já na criação do torneio.
model Phase {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  type         PhaseType
  // Posição da fase dentro do torneio (1 = primeira).
  order        Int
  name         String

  matches          Match[]
  coinTransactions CoinTransaction[]

  @@unique([tournamentId, order])
}

// Um confronto entre dois times dentro de uma fase. O placar não é um campo
// aqui: é sempre derivado da contagem de Goal por time (ver tournaments.service
// `computeMatchScore`). `playedAt` é o que diferencia "ainda não jogado" de
// "terminou 0 a 0" — sem ele, as duas situações teriam zero Goal e seriam
// indistinguíveis.
model Match {
  id         String    @id @default(uuid()) @db.Uuid
  phaseId    String    @db.Uuid
  phase      Phase     @relation(fields: [phaseId], references: [id])
  homeTeamId String    @db.Uuid
  homeTeam   Team      @relation("MatchHomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String    @db.Uuid
  awayTeam   Team      @relation("MatchAwayTeam", fields: [awayTeamId], references: [id])
  // Preenchido só em fases do tipo GROUP (ex.: "A", "B").
  groupLabel String?
  // Rodada (turno) dentro do grupo — todo time joga uma vez por rodada.
  // Preenchido só em fases do tipo GROUP, igual groupLabel.
  round      Int?
  // Quando o resultado foi registrado (null = ainda não jogado).
  playedAt   DateTime?

  // Resultado dos pênaltis, preenchido só quando a partida é de mata-mata
  // (Phase.type == KNOCKOUT) e termina empatada no tempo normal — uma
  // eliminatória não pode terminar empatada (ver
  // TournamentsService.replaceMatchGoals/simulateMatch). Null quando não
  // houve empate ou a fase não é KNOCKOUT. Os pênaltis não geram Goal: não
  // contam pra artilharia/assistências, só decidem quem avança (ver
  // advanceKnockoutRound e determineChampionTeamId).
  penaltyHomeScore    Int?
  penaltyAwayScore    Int?
  penaltyWinnerTeamId String? @db.Uuid
  penaltyWinnerTeam   Team?   @relation("MatchPenaltyWinner", fields: [penaltyWinnerTeamId], references: [id])

  goals            Goal[]
  coinTransactions CoinTransaction[]

  createdAt DateTime @default(now())

  @@index([phaseId])
}

// Um gol de uma partida. `teamId` é o lado da partida (homeTeamId ou
// awayTeamId) pelo qual o gol conta — snapshot tirado na hora do registro
// (ver TournamentsService.replaceMatchGoals/simulateMatch), não derivado do
// time atual do `scorer`: com transferências, o elenco de um time nessa
// temporada (PlayerTeamAssignment) pode não ser mais o elenco real do
// jogador (Player.teamId), e esse elenco pode mudar de novo depois que o
// gol já foi registrado. Sem esse snapshot, uma troca posterior corromperia
// o placar de partidas já jogadas.
model Goal {
  id       String  @id @default(uuid()) @db.Uuid
  matchId  String  @db.Uuid
  match    Match   @relation(fields: [matchId], references: [id])
  teamId   String  @db.Uuid
  team     Team    @relation("GoalScoringTeam", fields: [teamId], references: [id])
  scorerId String  @db.Uuid
  scorer   Player  @relation("GoalScorer", fields: [scorerId], references: [id])
  // Opcional: nem todo gol tem assistência.
  assistId String? @db.Uuid
  assist   Player? @relation("GoalAssist", fields: [assistId], references: [id])

  createdAt DateTime @default(now())

  @@index([matchId])
}

// "Foto", dentro de uma temporada, de qual time cada jogador defende na liga.
// Criada a partir do Player.teamId real quando a temporada começa; trocas
// (Transferência) alteram essa foto (teamId) e também isStarter, nunca o
// Player.teamId.
model PlayerTeamAssignment {
  id        String  @id @default(uuid()) @db.Uuid
  seasonId  String  @db.Uuid
  season    Season  @relation(fields: [seasonId], references: [id])
  playerId  String  @db.Uuid
  player    Player  @relation(fields: [playerId], references: [id])
  teamId    String  @db.Uuid
  team      Team    @relation(fields: [teamId], references: [id])
  // Titular (true) ou banco (false) do elenco DESSE time nessa temporada.
  // Inicializado a partir do TeamLineupSlot real (SoFIFA) do jogador quando
  // a temporada começa. Numa troca, é o SLOT que troca de dono, não o
  // status intrínseco do jogador: quem entra assume o isStarter de quem
  // saiu, e vice-versa (ver TransfersRepository.swap) — garante que todo
  // elenco sempre tem exatamente 11 titulares, independente de quantas
  // trocas aconteçam.
  isStarter Boolean @default(false)

  // Posição do slot da formação que esse titular ocupa (null quando no
  // banco). Pertence ao SLOT, não ao jogador: numa troca ou reposicionamento
  // (ver SwapLineupStarterUseCase) ou numa troca de formação (ver
  // ChangeSquadFormationUseCase), é este campo que se move entre jogadores —
  // a posição natural do jogador (PlayerPosition) nunca muda.
  lineupPosition PositionCode?

  @@unique([seasonId, playerId])
  @@index([seasonId, teamId])
}

// Origem de um Transfer: mercado tradicional (preço fixo pela política de
// pricing, instantâneo) ou negociação direta aceita (preço livre, precisou
// de aceite do targetSquad — ver DirectNegotiation).
enum TransferOriginType {
  MARKET
  NEGOTIATION
}

// Log de qualquer movimentação de jogador e/ou moeda já concluída — a
// "tabela de fato", independente de ter nascido do mercado tradicional ou
// de uma negociação direta aceita (ver originType/negotiationId). Sem custo
// próprio: o valor fica inteiramente no ledger (CoinTransaction/
// CouponTransaction ligados a este id) — este registro existe só para dar
// rastro de quem trocou o quê e quando. outgoing/incomingTeamId são sempre
// os dois lados da movimentação (squads envolvidos), preenchidos mesmo
// quando o jogador daquele lado é nulo — numa compra pura, por exemplo, não
// existe outgoingPlayer, mas outgoingTeamId ainda identifica quem comprou.
model Transfer {
  id         String             @id @default(uuid()) @db.Uuid
  seasonId   String             @db.Uuid
  season     Season             @relation(fields: [seasonId], references: [id])
  originType TransferOriginType

  requestedByUserId String @db.Uuid
  requestedBy       User   @relation(fields: [requestedByUserId], references: [id])

  // outgoingPlayerId nulo numa compra pura nascida de negociação direta (só
  // o incoming existe) — outgoingTeamId continua preenchido (identifica o
  // squad desse lado da movimentação, mesmo sem jogador saindo dele). No
  // mercado tradicional (originType = MARKET) é sempre uma troca, então os
  // dois jogadores são sempre preenchidos.
  outgoingPlayerId String? @db.Uuid
  outgoingPlayer   Player? @relation("TransferOutgoingPlayer", fields: [outgoingPlayerId], references: [id])
  outgoingTeamId   String  @db.Uuid
  outgoingTeam     Team    @relation("TransferOutgoingTeam", fields: [outgoingTeamId], references: [id])

  // incomingPlayerId nulo numa venda pura nascida de negociação direta (só
  // o outgoing existe) — incomingTeamId continua preenchido, mesma lógica
  // de outgoingTeamId acima.
  incomingPlayerId String? @db.Uuid
  incomingPlayer   Player? @relation("TransferIncomingPlayer", fields: [incomingPlayerId], references: [id])
  incomingTeamId   String  @db.Uuid
  incomingTeam     Team    @relation("TransferIncomingTeam", fields: [incomingTeamId], references: [id])

  // Overall dos dois jogadores no momento da movimentação (ver
  // docs/regras-temporada/v1-transferencias.md) — snapshot, não aponta pro
  // Player: se o scraper atualizar o overall depois, a auditoria continua
  // recalculando o custo com o valor que valia na hora da movimentação.
  // Nulo no lado correspondente a um outgoing/incomingPlayerId nulo.
  outgoingPlayerOverall Int?
  incomingPlayerOverall Int?

  // Snapshot de NegotiationWindow.feeEnabled no momento da movimentação — a
  // auditoria recalcula o custo com esse valor, nunca com o estado atual
  // da janela (que pode já ter virado outra coisa).
  feeEnabled Boolean

  // Só setado quando originType = NEGOTIATION: liga ao DirectNegotiation
  // (a proposta) que originou esta movimentação — 1:1, uma negociação
  // aceita gera exatamente um Transfer.
  negotiationId String?            @unique @db.Uuid
  negotiation   DirectNegotiation? @relation(fields: [negotiationId], references: [id])

  coinTransactions   CoinTransaction[]
  couponTransactions CouponTransaction[]

  createdAt DateTime @default(now())

  @@index([seasonId])
}

// Status de uma negociação direta entre dois participantes (ver
// docs/regras-temporada/v1-transferencias.md, seção 2). PENDING até o
// targetSquad decidir; nenhum efeito (ledger, PlayerTeamAssignment) é
// aplicado antes de virar ACCEPTED.
enum DirectNegotiationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// Negociação livre entre dois participantes (compra direta por moedas,
// troca sem moedas, ou troca com compensação em moedas) — sem taxa fixa
// nem fórmula de preço, ao contrário de Transfer (mercado tradicional).
// Precisa do aceite do targetSquad pra se efetivar (ver seção 2 do
// regulamento); até lá fica PENDING e não move nenhum jogador nem moeda.
model DirectNegotiation {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])

  proposingSquadId String @db.Uuid
  proposingSquad   Squad  @relation("DirectNegotiationProposingSquad", fields: [proposingSquadId], references: [id])
  targetSquadId    String @db.Uuid
  targetSquad      Squad  @relation("DirectNegotiationTargetSquad", fields: [targetSquadId], references: [id])

  // Jogador que sai do proposingSquad em direção ao targetSquad. Nulo numa
  // compra direta (proposingSquad só paga moedas pelo incomingPlayer).
  outgoingPlayerId String? @db.Uuid
  outgoingPlayer   Player? @relation("DirectNegotiationOutgoingPlayer", fields: [outgoingPlayerId], references: [id])

  // Jogador que sai do targetSquad em direção ao proposingSquad. Nulo numa
  // venda (proposingSquad só entrega o outgoingPlayer por moedas).
  incomingPlayerId String? @db.Uuid
  incomingPlayer   Player? @relation("DirectNegotiationIncomingPlayer", fields: [incomingPlayerId], references: [id])

  // Moedas pagas pelo proposingSquad ao targetSquad no aceite. Negativo
  // significa que é o targetSquad quem paga o proposingSquad. Nulo/0 quando
  // a negociação não envolve compensação financeira (troca pura).
  coinAmount Int?

  status DirectNegotiationStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  // Setado só depois do aceite (status = ACCEPTED) — é o Transfer gerado
  // pela aceitação, que carrega o snapshot de overall/feeEnabled e o
  // ledger (ver Transfer.negotiationId). Null enquanto PENDING/REJECTED.
  transfer Transfer?
  clauses  DirectNegotiationClause[]

  @@index([seasonId])
  @@index([targetSquadId, status])
}

// Tipos de cláusula contratual básica do regulamento (ver
// docs/regras-temporada/v1-transferencias.md, seção 4) — as "cláusulas
// avançadas" (rescisão automática, intransferível, fidelidade) ainda não
// foram validadas pelo grupo e ficam de fora por ora.
enum DirectNegotiationClauseType {
  LEI_DO_EX
  DIREITO_DE_RECOMPRA
  PREFERENCIA_DE_COMPRA
  BONUS_POR_TITULO
}

// Cláusula contratual anexada a uma negociação direta. Sem fiscalização
// automática (ver seção 5 do regulamento: descumprimento é resolvido entre
// os participantes, fora do app) — isso aqui é só o registro do que foi
// acordado, pra consulta e auditoria. Aceite é o mesmo da negociação como
// um todo: a cláusula só existe atrelada a uma proposta, e vale a partir do
// momento em que o targetSquad aceita a negociação (ver AcceptNegotiationUseCase).
model DirectNegotiationClause {
  id            String                      @id @default(uuid()) @db.Uuid
  negotiationId String                      @db.Uuid
  negotiation   DirectNegotiation           @relation(fields: [negotiationId], references: [id])
  type          DirectNegotiationClauseType

  // Jogador a que a cláusula se refere — sempre um dos dois jogadores
  // envolvidos na negociação (ver validação em ProposeNegotiationUseCase).
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  // Preço da recompra (DIREITO_DE_RECOMPRA) ou valor do bônus
  // (BONUS_POR_TITULO). Nulo nos outros tipos.
  amount Int?

  // Número de partidas que o jogador não pode enfrentar o ex-clube
  // (LEI_DO_EX). Nulo nos outros tipos.
  matchesCount Int?

  // Condição livre não capturada nos campos acima (prazo, campeonato
  // específico, etc.) — ver exemplos na seção 4 do regulamento.
  terms String?

  createdAt DateTime @default(now())

  @@index([negotiationId])
}

enum NotificationType {
  TRANSFER_COMPLETED
  TOURNAMENT_PRIZE_AWARDED
  AUDIT_DISCREPANCY_FOUND
  NEGOTIATION_PROPOSED
  NEGOTIATION_ACCEPTED
  NEGOTIATION_REJECTED
  SEASON_STARTED
}

// Notificação assíncrona gerada a partir de um evento de domínio (ver
// src/notifications/events) — transferência concluída, prêmio de torneio
// creditado, auditoria com divergência. Isolada por seasonId (como
// squads/transfers/negociações) pra quem trocou de temporada não ver
// notificação de uma temporada antiga nem de outra. Fora isso fica achatada
// (sem relação direta pra transfer/squad) porque cada tipo referencia
// entidades diferentes; o vínculo com o recurso de origem vai em `metadata`.
model Notification {
  id       String           @id @default(uuid()) @db.Uuid
  seasonId String           @db.Uuid
  season   Season           @relation(fields: [seasonId], references: [id])
  userId   String           @db.Uuid
  user     User             @relation(fields: [userId], references: [id])
  type     NotificationType
  title    String
  message  String
  metadata Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([seasonId, userId, readAt])
}

// Período, aberto e fechado manualmente pelo admin, em que transferências
// (mercado tradicional) e negociações diretas são permitidas numa season —
// ver docs/regras-temporada/v1-transferencias.md. feeEnabled é decidido na
// abertura e vale pra toda a janela: liga a faixa progressiva do
// transferPricing do ruleset vigente (hoje cobrada incondicionalmente no
// mercado tradicional) e, só pra negociações que envolvem troca de
// jogadores, passa a cobrar a mesma faixa como taxa adicional (ver
// negotiation-fee.utils.ts). No máximo uma janela aberta (closedAt null)
// por season — validado em OpenNegotiationWindowUseCase, não por
// constraint de banco.
model NegotiationWindow {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])

  feeEnabled Boolean

  openedAt       DateTime @default(now())
  openedByUserId String   @db.Uuid
  openedBy       User     @relation("NegotiationWindowOpenedBy", fields: [openedByUserId], references: [id])

  closedAt       DateTime?
  closedByUserId String?   @db.Uuid
  closedBy       User?     @relation("NegotiationWindowClosedBy", fields: [closedByUserId], references: [id])

  @@index([seasonId, closedAt])
}
