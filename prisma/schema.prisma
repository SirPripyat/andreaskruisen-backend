// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PreferredFoot {
  LEFT
  RIGHT
}

enum PositionCode {
  GOL
  ZAG
  LD
  LE
  VOL
  MC
  MD
  ME
  MEI
  PD
  PE
  ATA
}

// Catálogo fechado das formações que aparecem no JSON de formações do
// scraper (ver src/import/formation-mapper.ts para o mapeamento entre o
// texto em português do scraper e estes valores).
enum Formation {
  THREE_ONE_FOUR_TWO           @map("3-1-4-2")
  THREE_FOUR_ONE_TWO           @map("3-4-1-2")
  THREE_FOUR_TWO_ONE           @map("3-4-2-1")
  THREE_FOUR_THREE             @map("3-4-3")
  THREE_FOUR_THREE_EM_LINHA    @map("3-4-3 Em linha")
  THREE_FIVE_TWO               @map("3-5-2")
  FOUR_ONE_TWO_ONE_TWO_ABERTO  @map("4-1-2-1-2 Aberto")
  FOUR_ONE_TWO_ONE_TWO_FECHADO @map("4-1-2-1-2 Fechado")
  FOUR_ONE_THREE_TWO           @map("4-1-3-2")
  FOUR_ONE_FOUR_ONE            @map("4-1-4-1")
  FOUR_TWO_ONE_THREE           @map("4-2-1-3")
  FOUR_TWO_TWO_TWO             @map("4-2-2-2")
  FOUR_TWO_THREE_ONE_ABERTO    @map("4-2-3-1 Aberto")
  FOUR_TWO_THREE_ONE_FECHADO   @map("4-2-3-1 Fechado")
  FOUR_THREE_ONE_TWO           @map("4-3-1-2")
  FOUR_THREE_TWO_ONE           @map("4-3-2-1")
  FOUR_THREE_THREE_CONSERVADOR @map("4-3-3 Conservador")
  FOUR_THREE_THREE_DEFENSIVO   @map("4-3-3 Defensivo")
  FOUR_THREE_THREE_EM_LINHA    @map("4-3-3 Em linha")
  FOUR_THREE_THREE_OFENSIVO    @map("4-3-3 Ofensivo")
  FOUR_FOUR_ONE_ONE_MEIO_CAMPO @map("4-4-1-1 Meio-campo")
  FOUR_FOUR_ONE_ONE_OFENSIVO   @map("4-4-1-1 Ofensivo")
  FOUR_FOUR_TWO_CONSERVADOR    @map("4-4-2 Conservador")
  FOUR_FOUR_TWO_EM_LINHA       @map("4-4-2 Em linha")
  FOUR_FIVE_ONE_EM_LINHA       @map("4-5-1 Em linha")
  FIVE_TWO_ONE_TWO             @map("5-2-1-2")
  FIVE_TWO_TWO_ONE             @map("5-2-2-1")
  FIVE_TWO_THREE               @map("5-2-3")
  FIVE_THREE_TWO_CONSERVADOR   @map("5-3-2 Conservador")
  FIVE_FOUR_ONE_EM_LINHA       @map("5-4-1 Em linha")
  FIVE_FOUR_ONE_LOSANGO        @map("5-4-1 Losango")
}

model Nationality {
  id      String @id @default(uuid()) @db.Uuid
  name    String @unique
  flagUrl String

  players Player[]
}

model League {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  teams Team[]
}

model Team {
  id   String @id @default(uuid()) @db.Uuid
  name String
  // Só exibição: o SoFIFA varia a resolução da imagem do escudo entre
  // execuções do scraper (ex.: .../90.png numa leva, .../60.png na
  // seguinte), então não é estável o suficiente pra ser chave de upsert
  // (já causou Team duplicado - ver @@unique([name, leagueId]) abaixo).
  crestUrl String

  // Formação padrão do time real, vinda do JSON de formações do scraper
  // (arquivo separado do de jogadores). Nula até a primeira importação.
  formation Formation?

  leagueId String @db.Uuid
  league   League @relation(fields: [leagueId], references: [id])

  players                 Player[]
  squads                  Squad[]
  seasonAssignments       PlayerTeamAssignment[]
  tournamentEntries       TournamentTeam[]
  matchesHome             Match[]                @relation("MatchHomeTeam")
  matchesAway             Match[]                @relation("MatchAwayTeam")
  matchesPenaltyWon       Match[]                @relation("MatchPenaltyWinner")
  goalsScored             Goal[]                 @relation("GoalScoringTeam")
  transfersAsOutgoingTeam Transfer[]             @relation("TransferOutgoingTeam")
  transfersAsIncomingTeam Transfer[]             @relation("TransferIncomingTeam")
  lineupSlots             TeamLineupSlot[]
  aliases                 TeamAlias[]

  // Chave natural real do time: o nome por si só pode colidir (ex.:
  // "Nacional" do Uruguai e de Portugal), mas nome dentro da mesma liga não
  // (dois times da mesma liga não têm o mesmo nome).
  @@unique([name, leagueId])
}

// Nome alternativo pelo qual um time é conhecido num catálogo externo além
// do seu Team.name canônico (ex.: "PSG" pro Paris Saint-Germain) — usado só
// pra resolver o import de escudos (ver team-crest-import.ts) quando o
// catálogo de times da EA usa uma abreviação que o de jogadores (fonte do
// Team.name) não usa. Curado manualmente; não afeta o que é exibido no app.
model TeamAlias {
  id    String @id @default(uuid()) @db.Uuid
  alias String @unique

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])
}

model Player {
  id            String        @id @default(uuid()) @db.Uuid
  // id do jogador no scraper (SoFIFA/EA), usado como chave de upsert na importação.
  eaId          Int           @unique
  name          String
  photoUrl      String
  birthdate     DateTime
  preferredFoot PreferredFoot

  nationalityId String      @db.Uuid
  nationality   Nationality @relation(fields: [nationalityId], references: [id])

  teamId String @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id])

  // Cópia do overall mais recente (igual ao último PlayerRating), mantida
  // pela importação só pra permitir ordenar a listagem por overall sem
  // precisar de uma query correlacionada em PlayerRating (histórico 1:N).
  latestOverallRating Int

  positions         PlayerPosition[]
  ratings           PlayerRating[]
  seasonAssignments PlayerTeamAssignment[]
  goalsScored       Goal[]                 @relation("GoalScorer")
  goalsAssisted     Goal[]                 @relation("GoalAssist")
  transfersOut      Transfer[]             @relation("TransferOutgoingPlayer")
  transfersIn       Transfer[]             @relation("TransferIncomingPlayer")
  lineupSlots       TeamLineupSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([latestOverallRating])
}

model PlayerPosition {
  id        String       @id @default(uuid()) @db.Uuid
  playerId  String       @db.Uuid
  player    Player       @relation(fields: [playerId], references: [id])
  position  PositionCode
  isPrimary Boolean      @default(false)

  @@unique([playerId, position])
}

// Escalação titular calculada do time (ver selectStartingLineup): quais 11
// jogadores do elenco real (Player.teamId) entram na média de overall do
// time, e em qual posição da formação cada um entraria. Recalculada inteira
// (delete + insert) a cada mudança de elenco ou via endpoint manual — nunca
// editada linha a linha. Time sem nenhuma linha aqui = escalação nunca
// calculada, e a média do time cai pro elenco inteiro (ver teams.repository).
model TeamLineupSlot {
  id       String       @id @default(uuid()) @db.Uuid
  teamId   String       @db.Uuid
  team     Team         @relation(fields: [teamId], references: [id])
  // Posição exigida pelo slot da formação, não necessariamente a posição
  // principal do jogador: quando o elenco não tem jogador suficiente numa
  // posição, o slot é preenchido pelo melhor jogador que sobrar de outra
  // posição (ver selectStartingLineup).
  position PositionCode
  playerId String       @db.Uuid
  player   Player       @relation(fields: [playerId], references: [id])

  @@unique([teamId, playerId])
}

// Série histórica dos atributos do jogador: só ganha uma linha nova quando
// o scraper traz algum valor diferente da última captura (ver import).
model PlayerRating {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])

  // Momento em que o scraper coletou esta versão dos dados (não a data do import).
  capturedAt      DateTime
  overallRating   Int
  skillMoves      Int
  weakFootAbility Int

  // Categorias agregadas (PAC/SHO/PAS/DRI/DEF/PHY). Opcionais: o scraper
  // deixou de enviá-las numa leva recente de dados.
  pac Int?
  sho Int?
  pas Int?
  dri Int?
  def Int?
  phy Int?

  // Atributos detalhados
  acceleration       Int
  agility            Int
  jumping            Int
  stamina            Int
  strength           Int
  aggression         Int
  balance            Int
  ballControl        Int
  composure          Int
  crossing           Int
  curve              Int
  defensiveAwareness Int
  dribbling          Int
  finishing          Int
  freeKickAccuracy   Int
  headingAccuracy    Int
  interceptions      Int
  longPassing        Int
  longShots          Int
  penalties          Int
  positioning        Int
  reactions          Int
  shortPassing       Int
  shotPower          Int
  slidingTackle      Int
  sprintSpeed        Int
  standingTackle     Int
  vision             Int
  volleys            Int

  // Atributos de goleiro (presentes em todo jogador, baixos para linha de campo)
  gkDiving      Int
  gkHandling    Int
  gkKicking     Int
  gkPositioning Int
  gkReflexes    Int

  @@index([playerId, capturedAt])
}

enum UserRole {
  PARTICIPANT
  ADMIN
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  pinHash   String
  role      UserRole @default(PARTICIPANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  squads             Squad[]
  transfersRequested Transfer[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Uma temporada funciona como o "tenant" da liga: todo estado de elenco e
// transferência pertence a uma temporada. Uma nova temporada começa com os
// jogadores nos times reais (vindos do scraper) — ver PlayerTeamAssignment.
model Season {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startedAt DateTime @default(now())
  // Temporada em que o app está operando agora. No máximo uma por vez — o
  // service sempre desmarca as outras antes de marcar uma nova (ver
  // SeasonsService.selectActive), dentro de uma transação.
  isActive  Boolean  @default(false)

  squads      Squad[]
  assignments PlayerTeamAssignment[]
  tournaments Tournament[]
  transfers   Transfer[]
}

// O elenco de um participante numa temporada: o time real que ele escolheu
// representar. Os jogadores do elenco são derivados via PlayerTeamAssignment
// (quem está "no time X" dentro dessa temporada), não guardados aqui.
model Squad {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id])
  teamId   String @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())

  @@unique([seasonId, userId])
  @@unique([seasonId, teamId])
}

enum TournamentFormat {
  // Liga: todos os times num turno único só (tabela), sem mata-mata — o
  // campeão é sempre o líder da tabela, por isso não faz sentido dividir em
  // mais de um grupo (não haveria confronto entre os líderes pra decidir).
  LEAGUE
  KNOCKOUT
  GROUP_STAGE_KNOCKOUT
}

// Um torneio dentro de uma temporada, com um conjunto fixo de times (ver
// TournamentTeam). Nem todo time do torneio tem dono: times sem Squad
// correspondente na mesma temporada são "máquinas" (CPU).
model Tournament {
  id        String           @id @default(uuid()) @db.Uuid
  seasonId  String           @db.Uuid
  season    Season           @relation(fields: [seasonId], references: [id])
  name      String
  format    TournamentFormat
  // Limite de times no torneio, validado contra as faixas do formato
  // (ver TEAM_COUNT_RULES em tournament-format-rules.ts).
  maxTeams  Int
  createdAt DateTime         @default(now())

  teams  TournamentTeam[]
  phases Phase[]

  @@index([seasonId])
}

// Os times que participam de um torneio. Quem controla cada time (ou se é
// CPU) não fica aqui: é derivado olhando o Squad dessa temporada pro mesmo
// teamId (existe Squad = tem dono; não existe = time de máquina).
model TournamentTeam {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamId       String     @db.Uuid
  team         Team       @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, teamId])
}

enum PhaseType {
  GROUP
  KNOCKOUT
}

// Uma etapa do torneio (ex.: fase de grupos, semifinal). As partidas de uma
// fase são todas geradas de uma vez, quando a fase começa; a fase seguinte só
// é gerada depois que esta termina (os confrontos dependem de quem avançou),
// então por ora só existe a Phase 1 — gerada já na criação do torneio.
model Phase {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  type         PhaseType
  // Posição da fase dentro do torneio (1 = primeira).
  order        Int
  name         String

  matches Match[]

  @@unique([tournamentId, order])
}

// Um confronto entre dois times dentro de uma fase. O placar não é um campo
// aqui: é sempre derivado da contagem de Goal por time (ver tournaments.service
// `computeMatchScore`). `playedAt` é o que diferencia "ainda não jogado" de
// "terminou 0 a 0" — sem ele, as duas situações teriam zero Goal e seriam
// indistinguíveis.
model Match {
  id         String    @id @default(uuid()) @db.Uuid
  phaseId    String    @db.Uuid
  phase      Phase     @relation(fields: [phaseId], references: [id])
  homeTeamId String    @db.Uuid
  homeTeam   Team      @relation("MatchHomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String    @db.Uuid
  awayTeam   Team      @relation("MatchAwayTeam", fields: [awayTeamId], references: [id])
  // Preenchido só em fases do tipo GROUP (ex.: "A", "B").
  groupLabel String?
  // Rodada (turno) dentro do grupo — todo time joga uma vez por rodada.
  // Preenchido só em fases do tipo GROUP, igual groupLabel.
  round      Int?
  // Quando o resultado foi registrado (null = ainda não jogado).
  playedAt   DateTime?

  // Resultado dos pênaltis, preenchido só quando a partida é de mata-mata
  // (Phase.type == KNOCKOUT) e termina empatada no tempo normal — uma
  // eliminatória não pode terminar empatada (ver
  // TournamentsService.replaceMatchGoals/simulateMatch). Null quando não
  // houve empate ou a fase não é KNOCKOUT. Os pênaltis não geram Goal: não
  // contam pra artilharia/assistências, só decidem quem avança (ver
  // advanceKnockoutRound e determineChampionTeamId).
  penaltyHomeScore    Int?
  penaltyAwayScore    Int?
  penaltyWinnerTeamId String?   @db.Uuid
  penaltyWinnerTeam   Team?     @relation("MatchPenaltyWinner", fields: [penaltyWinnerTeamId], references: [id])

  goals Goal[]

  createdAt DateTime @default(now())

  @@index([phaseId])
}

// Um gol de uma partida. `teamId` é o lado da partida (homeTeamId ou
// awayTeamId) pelo qual o gol conta — snapshot tirado na hora do registro
// (ver TournamentsService.replaceMatchGoals/simulateMatch), não derivado do
// time atual do `scorer`: com transferências, o elenco de um time nessa
// temporada (PlayerTeamAssignment) pode não ser mais o elenco real do
// jogador (Player.teamId), e esse elenco pode mudar de novo depois que o
// gol já foi registrado. Sem esse snapshot, uma troca posterior corromperia
// o placar de partidas já jogadas.
model Goal {
  id       String  @id @default(uuid()) @db.Uuid
  matchId  String  @db.Uuid
  match    Match   @relation(fields: [matchId], references: [id])
  teamId   String  @db.Uuid
  team     Team    @relation("GoalScoringTeam", fields: [teamId], references: [id])
  scorerId String  @db.Uuid
  scorer   Player  @relation("GoalScorer", fields: [scorerId], references: [id])
  // Opcional: nem todo gol tem assistência.
  assistId String? @db.Uuid
  assist   Player? @relation("GoalAssist", fields: [assistId], references: [id])

  createdAt DateTime @default(now())

  @@index([matchId])
}

// "Foto", dentro de uma temporada, de qual time cada jogador defende na liga.
// Criada a partir do Player.teamId real quando a temporada começa; trocas
// (Transferência) alteram essa foto (teamId) e também isStarter, nunca o
// Player.teamId.
model PlayerTeamAssignment {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])
  playerId String @db.Uuid
  player   Player @relation(fields: [playerId], references: [id])
  teamId   String @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id])
  // Titular (true) ou banco (false) do elenco DESSE time nessa temporada.
  // Inicializado a partir do TeamLineupSlot real (SoFIFA) do jogador quando
  // a temporada começa. Numa troca, é o SLOT que troca de dono, não o
  // status intrínseco do jogador: quem entra assume o isStarter de quem
  // saiu, e vice-versa (ver TransfersRepository.swap) — garante que todo
  // elenco sempre tem exatamente 11 titulares, independente de quantas
  // trocas aconteçam.
  isStarter Boolean @default(false)

  @@unique([seasonId, playerId])
  @@index([seasonId, teamId])
}

// Log de uma troca de jogadores já concluída. Sem custo por ora (ver
// PlayerTeamAssignment): a troca só atualiza a "foto" de quem joga em qual
// time; este registro existe só para dar rastro de auditoria de quem trocou
// o quê e quando. outgoing/incomingTeamId guardam o time de cada jogador
// antes da troca, já que PlayerTeamAssignment só guarda o estado atual.
model Transfer {
  id       String @id @default(uuid()) @db.Uuid
  seasonId String @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id])

  requestedByUserId String @db.Uuid
  requestedBy       User   @relation(fields: [requestedByUserId], references: [id])

  outgoingPlayerId String @db.Uuid
  outgoingPlayer   Player @relation("TransferOutgoingPlayer", fields: [outgoingPlayerId], references: [id])
  outgoingTeamId   String @db.Uuid
  outgoingTeam     Team   @relation("TransferOutgoingTeam", fields: [outgoingTeamId], references: [id])

  incomingPlayerId String @db.Uuid
  incomingPlayer   Player @relation("TransferIncomingPlayer", fields: [incomingPlayerId], references: [id])
  incomingTeamId   String @db.Uuid
  incomingTeam     Team   @relation("TransferIncomingTeam", fields: [incomingTeamId], references: [id])

  createdAt DateTime @default(now())

  @@index([seasonId])
}
