POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

PORT=

FRONTEND_URL=

SALT_ROUND=

DEFAULT_USER_NAME=
DEFAULT_USER_PIN=

GCS_BUCKET=

# Local dev only: aponta o SDK do GCS pro fake-gcs-server do docker-compose,
# em vez de bater no Google Cloud de verdade. Deixe vazio/comentado em produção.
STORAGE_EMULATOR_HOST=http://localhost:4443/storage/v1

# Local dev only: credencial fake (gerada com `openssl genrsa`), só pra
# satisfazer a assinatura de signed URL — o fake-gcs-server não valida a
# assinatura de verdade. Deixe vazio/comentado em produção.
GOOGLE_APPLICATION_CREDENTIALS=.fake-gcs/fake-creds.json
